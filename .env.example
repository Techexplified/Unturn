# Unturn — Shopify Return-Prevention App
# Production and Local Environment Configuration

# Shopify App Credentials (from Shopify Partner Dashboard)
SHOPIFY_API_KEY=your_shopify_app_client_id
SHOPIFY_API_SECRET=your_shopify_app_client_secret
SCOPES=read_orders,read_products,read_returns,write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=https://your-production-app.domain.com

# Database URL (SQLite for local / container, or PostgreSQL / MySQL via Prisma adapter)
DATABASE_URL="file:dev.sqlite"

# AI Provider API Key (Groq or Gemini for AI-driven root cause reasoning and recommendation generation)
GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key

# Email Notification Service (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Unturn <onboarding@resend.dev>"

# Node Environment & Server Port
NODE_ENV=production
PORT=3000
